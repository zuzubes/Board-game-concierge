    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.sentMessages = staticData.sentMessages || [];\nstaticData.incomingMessages = staticData.incomingMessages || [];\n\nconst result = $json.result || {};\nconst messageId = result.message_id;\nconst chatId = result.chat && result.chat.id;\n\nif (messageId && chatId) {\n  staticData.sentMessages.push({ messageId, chatId, timestamp: Date.now() });\n}\n\n// Messages older than 48h can never be deleted via the Bot API anyway,\n// so there's no reason to keep tracking them - prune globally on every\n// write to keep the store naturally bounded.\nconst cutoff = Date.now() - 48 * 60 * 60 * 1000;\nstaticData.sentMessages = staticData.sentMessages.filter((m) => m.timestamp >= cutoff);\nstaticData.incomingMessages = staticData.incomingMessages.filter((m) => m.timestamp >= cutoff);\n\nreturn [{ json: {} }];"
      },
      "id": "code-track-sent-message",
