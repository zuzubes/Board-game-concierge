      "parameters": {
        "jsCode": "const text = $input.item.json.message.text || '';\nconst game = text.replace(/^\\/tips?\\s*/i, '').trim();\nreturn [{ json: { game, backendBaseUrl: $input.item.json.backendBaseUrl } }];"
