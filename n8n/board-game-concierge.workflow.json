      "id": "if-reset",
      "name": "Is Reset Command",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        280,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst staticData = $getWorkflowStaticData('global');\nconst sent = staticData.sentMessages || [];\nconst incoming = staticData.incomingMessages || [];\nconst cutoff = Date.now() - 48 * 60 * 60 * 1000;\n\nconst candidates = [...sent, ...incoming].filter((m) => m.chatId === chatId && m.timestamp >= cutoff);\nconst unique = new Map();\nfor (const message of candidates) {\n  unique.set(`${message.chatId}:${message.messageId}`, message);\n}\n\nstaticData.sentMessages = sent.filter((m) => m.chatId !== chatId);\nstaticData.incomingMessages = incoming.filter((m) => m.chatId !== chatId);\n\nreturn Array.from(unique.values()).map((m) => ({ json: { chatId: m.chatId, messageId: m.messageId } }));"
      },
